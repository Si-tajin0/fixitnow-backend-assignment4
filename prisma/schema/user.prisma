model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  phone     String?
  address   String?
  rating    Float    @default(0.0)
  creatdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relation
  technicianProfile TecnicianProfile?

  @@map("users")
}
