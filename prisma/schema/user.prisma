model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  phone     String?
  address   String?
  rating    Float      @default(0.0)
  creatdAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  //Relation
  technicianProfile TecnicianProfile?
  servicesAsTech    Service[]         @relation("TechnicianServices")

  reviews Review[] @relation("CustomerReviews")

  bookingsAsCust Booking[] @relation("CustomerBookings")
  bookingsAsTeck Booking[] @relation("TechnicianBookings")

  @@map("users")
}
